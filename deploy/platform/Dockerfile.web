FROM node:24-alpine@sha256:50c8e8ca1d27439048670df5883f32d57cf81cff6233222c893fd0d9884cbd81 AS build
WORKDIR /app
COPY services/review-workbench/package.json services/review-workbench/package-lock.json ./
RUN npm ci
COPY services/review-workbench ./
RUN npm run build
FROM nginx:stable-alpine@sha256:dc5069ad14f19660b141b21236140b91656bf89bbc3e2417c70ae650cd66104c
COPY deploy/platform/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
RUN cp /usr/share/nginx/html/platform.html /usr/share/nginx/html/index.html
EXPOSE 8080
