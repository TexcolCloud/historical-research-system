{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "PackageFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "role": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "upstream_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream Id"
        }
      },
      "required": [
        "path",
        "role",
        "byte_length",
        "sha256"
      ],
      "title": "PackageFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/PackageFile"
      },
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "source_bindings": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Source Bindings",
      "type": "array"
    },
    "upstream_entry": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Upstream Entry"
    }
  },
  "required": [
    "schema_version",
    "files",
    "source_bindings"
  ],
  "title": "PackageManifest",
  "type": "object"
}
