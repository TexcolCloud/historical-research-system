{
  "render_dpi": 300,
  "ocr_backends": [
    {
      "name": "docling",
      "kind": "docling",
      "rapidocr": {
        "mode": "full_page",
        "backend": "torch",
        "scale": 4.166666666666667
      }
    }
  ],
  "vision_review": {
    "timeout_seconds": 180,
    "cache_enabled": true,
    "enabled": true,
    "cache_path": "state/vision-review-cache"
  },
  "risk": {
    "auto_accept": true,
    "enabled": true
  },
  "acceleration": {
    "device": "auto",
    "device_id": 0,
    "dtype": "float16",
    "attention": "auto",
    "fast_min_vram_gb": 12,
    "enforce_vram_limit": true,
    "max_vram_gb": 15.0,
    "cpu_threads": 8,
    "cpu_fallback": true
  }
}
