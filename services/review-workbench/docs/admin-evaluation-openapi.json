      "post": {
        "operationId": "post_experiments",
        "x-required-role": "admin",
        "security": [
          {
            "gatewayAccount": []
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded diagnostic or persisted evaluation receipt"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin or same-origin check failed"
          },
          "409": {
            "description": "Version, lifecycle or idempotency conflict"
          },
          "422": {
            "description": "Unsupported or invalid command"
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "expected_version": {
                    "minimum": 0,
                    "title": "Expected Version",
                    "type": "integer"
                  },
                  "dataset": {
                    "pattern": "^[a-zA-Z0-9_-]{1,100}$",
                    "title": "Dataset",
                    "type": "string"
                  },
                  "mode": {
                    "enum": [
                      "synthetic_engineering",
                      "fresh_pipeline"
                    ],
                    "title": "Mode",
                    "type": "string"
                  },
                  "variant": {
                    "default": "intact",
                    "enum": [
                      "intact",
                      "changed_quote"
                    ],
                    "title": "Variant",
                    "type": "string"
                  },
                  "repetitions": {
                    "default": 1,
                    "maximum": 3,
                    "minimum": 1,
                    "title": "Repetitions",
                    "type": "integer"
                  },
                  "max_units": {
                    "default": 6,
                    "maximum": 600,
                    "minimum": 1,
                    "title": "Max Units",
                    "type": "integer"
                  },
                  "max_model_calls": {
                    "default": 0,
                    "maximum": 65536,
                    "minimum": 0,
                    "title": "Max Model Calls",
                    "type": "integer"
                  },
                  "max_cost": {
                    "default": 0,
                    "maximum": 1000,
                    "minimum": 0,
                    "title": "Max Cost",
                    "type": "number"
                  },
                  "target": {
                    "anyOf": [
                      {
                        "pattern": "^[a-zA-Z0-9_-]{1,100}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Target"
                  }
                },
                "required": [
                  "expected_version",
                  "dataset",
                  "mode"
                ],
                "title": "Prepare",
                "type": "object"
              }
            }
          }
        }
      }
    },
