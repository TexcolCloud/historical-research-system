# Copy this file to .env in the project root. Never commit .env.
HRS_MODEL_ROOT=models
HRS_OCR_DEVICE=auto
HRS_OCR_DEVICE_ID=0
HRS_ENFORCE_VRAM_LIMIT=true
HRS_MAX_VRAM_GB=15.0
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_MODE=responses
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_API_MODE=responses
DEEPSEEK_VISION_MODEL=deepseek-flash

# Historical document ingestion: all modules share this root template and .env.
# Use a dedicated local password and URL-encode it inside both database URLs.
# Changing this value does not change an existing PostgreSQL role password.
INGEST_DEV_DB_PASSWORD=replace-with-a-local-only-password
INGEST_DEV_DB_PORT=55436
INGEST_DATABASE_URL=postgresql+psycopg://ingestion_owner:replace-with-a-local-only-password@127.0.0.1:55436/ingestion_dev
INGEST_TEST_DATABASE_URL=postgresql+psycopg://ingestion_owner:replace-with-a-local-only-password@127.0.0.1:55436/ingestion_test

# Local S3 acceptance service; do not put real credentials in this template.
INGEST_S3_ENDPOINT_URL=http://127.0.0.1:58333
INGEST_S3_REGION=us-east-1
INGEST_S3_BUCKET=ingestion-acceptance
INGEST_S3_ACCESS_KEY=replace-with-an-acceptance-access-key
INGEST_S3_SECRET_KEY=replace-with-an-acceptance-secret

# Ingestion assistance and automatic whole-book organization reuse DEEPSEEK_* above.
# Optional INGEST_DEEPSEEK_* values override the shared provider settings for ingestion only.
INGEST_DEEPSEEK_BOOK_BATCH_CODEPOINTS=12000
INGEST_DEEPSEEK_BOOK_MAX_CALLS=128
INGEST_DEEPSEEK_BOOK_MAX_INPUT_CODEPOINTS=2000000

# Research cards: dedicated databases; API key and endpoint reuse DEEPSEEK_* above.
CARDS_DATABASE_URL=postgresql+psycopg://ingestion_owner:replace-with-a-local-only-password@127.0.0.1:55436/historical_research_cards
CARDS_TEST_DATABASE_URL=postgresql+psycopg://ingestion_owner:replace-with-a-local-only-password@127.0.0.1:55436/historical_research_cards_test
# Non-secret endpoints and auto_sync=false are in services/research-cards/config/development.toml.
# Optional CARDS_DEEPSEEK_API_KEY and CARDS_DEEPSEEK_BASE_URL override shared model access.

# 史料卡主 agent：规划、补查决策、综合、语义核查及论文提示。
CARDS_REASONING_MODEL=deepseek-flash
PLATFORM_READING_MAX_OUTPUT=16000
PLATFORM_REASONING_MAX_OUTPUT=32000
# Only confirmed output truncation increases the next request budget, up to this ceiling.
PLATFORM_MODEL_MAX_OUTPUT_CEILING=64000
# Separate per-run hard call caps; explicit retries do not reset spent requests.
PLATFORM_MODEL_MAX_CALLS=4096
PLATFORM_VISION_MAX_CALLS=4096
CARDS_REASONING_EFFORT=high
# 史料卡子 agent：逐段阅读及定向补查。
CARDS_READING_MODEL=deepseek-flash
CARDS_READING_REASONING_EFFORT=low
# 史料卡原图核查。
CARDS_VISION_MODEL=Qwen3-VL-8B-Instruct-Q4_K_M
CARDS_VISION_REASONING_EFFORT=low

# Local visual review; DeepSeek variables above apply to text only.
HRS_LOCAL_VISION_URL=http://127.0.0.1:18160
HRS_GPU_RESERVE_GIB=1.5
HRS_OCR_PEAK_GIB=6
HRS_VISION_PEAK_GIB=9

# V2 modular platform. Bootstrap creates these independent databases; no legacy data migration.
# Same PostgreSQL/S3 services as above; business files always use S3.
PLATFORM_DATABASE_URL=postgresql+psycopg://ingestion_owner:replace-with-a-local-only-password@127.0.0.1:55436/historical_research_v2
PLATFORM_TEST_DATABASE_URL=postgresql+psycopg://ingestion_owner:replace-with-a-local-only-password@127.0.0.1:55436/historical_research_v2_test
PLATFORM_TEMPORAL_ADDRESS=127.0.0.1:17233
PLATFORM_TEMPORAL_NAMESPACE=historical-research
PLATFORM_TASK_QUEUE=hrs-books-v2
PLATFORM_GPU_QUEUE=hrs-gpu-v2
PLATFORM_RETRIEVAL_DEVICE=cuda
PLATFORM_RETRIEVAL_ENDPOINT=http://127.0.0.1:18160/retrieval
HRS_RETRIEVAL_PEAK_GIB=6
# Local model cold-start deadline (seconds); existing weights can need paging after GPU handoff.
HRS_VISION_START_TIMEOUT=600
