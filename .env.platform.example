# Copy required entries to root .env. Never commit real credentials.
INGEST_DATABASE_URL=postgresql+psycopg://ingestion_owner:CHANGE_ME@127.0.0.1:55436/postgres
INGEST_DEV_DB_PORT=55436
INGEST_DEV_DB_PASSWORD=CHANGE_ME
INGEST_S3_ENDPOINT_URL=http://127.0.0.1:58333
INGEST_S3_BUCKET=historical-research
INGEST_S3_ACCESS_KEY=CHANGE_ME
INGEST_S3_SECRET_KEY=CHANGE_ME
INGEST_S3_REGION=us-east-1
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
CARDS_REASONING_MODEL=deepseek-v4-pro
CARDS_READING_MODEL=deepseek-flash
# init derives PLATFORM_DATABASE_URL, PLATFORM_TEST_DATABASE_URL and
# PLATFORM_DOCKER_DATABASE_URL, without changing existing database contents.
PLATFORM_API_PORT=18170
PLATFORM_WEB_PORT=18156
PLATFORM_OPENSEARCH_URL=http://127.0.0.1:19260
# Set false to finish after library publication and retrieval indexing, without automatic cards.
PLATFORM_AUTO_CARDS_ENABLED=true
