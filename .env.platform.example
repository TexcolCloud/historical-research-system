# Default host-native Codex platform: SQL/S3 configuration.
# First installation only: copy to root .env and replace every CHANGE_ME.
# Keep existing credentials, database URLs and Compose project names when upgrading.
# Independent Codex MCP usage does not require this file.

# SQL bootstrap: URL password and INGEST_DEV_DB_PASSWORD must match.
# URL-encode special characters in the URL password; keep the raw password below.
INGEST_DATABASE_URL=postgresql+psycopg://ingestion_owner:CHANGE_ME@127.0.0.1:55436/postgres
INGEST_DEV_DB_PORT=55436
INGEST_DEV_DB_PASSWORD=CHANGE_ME
# init writes missing PLATFORM_DATABASE_URL, PLATFORM_TEST_DATABASE_URL and
# PLATFORM_DOCKER_DATABASE_URL; keep those generated values on later runs.

# S3: shared by resumable uploads and platform business objects.
INGEST_S3_ENDPOINT_URL=http://127.0.0.1:58333
INGEST_S3_BUCKET=historical-research
INGEST_S3_ACCESS_KEY=CHANGE_ME
INGEST_S3_SECRET_KEY=CHANGE_ME
INGEST_S3_REGION=us-east-1

# Native workspace (optional): backend defaults to codex; Terra/Sol run in Codex.
# No local OCR/vision weights or DeepSeek key are required for native processing.
# Leave the root unset to use the shared project workspace configuration.
# If explicitly overriding it, align the CLI/MCP process root and workspace_id too.
# PLATFORM_CODEX_ROOT=state/codex

# Retrieval (optional): these are the code defaults; both devices need BGE weights.
# Set cpu explicitly only when selecting CPU retrieval.
# PLATFORM_RETRIEVAL_DEVICE=cuda
# PLATFORM_OPENSEARCH_URL=http://127.0.0.1:19260
# PLATFORM_RETRIEVAL_ENDPOINT=http://127.0.0.1:18160/retrieval
# HRS_GPU_RESERVE_GIB=1.5

# Leave COMPOSE_PROJECT_NAME unset for a new installation to keep each Compose
# file's declared project name. Preserve its existing value when one is in use.
